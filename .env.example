# FTP source
FTP_HOST=ftp.example.local
FTP_PORT=21
FTP_USER=parking-reader
FTP_PASSWORD=change-me
FTP_ROOT_DIR=/
FTP_RECURSIVE=true
FTP_PASSIVE=true
FTP_TIMEOUT_SECONDS=30
FTP_ENCODING=utf-8

# A file must have the same size/mtime for this many scans before processing.
FTP_STABLE_POLLS=2
POLL_INTERVAL_SECONDS=60

# Series: normalized plate + Address + CameraSerialNumber.
SERIES_WINDOW_MINUTES=15

# Work scheduling. Old assessments are refreshed only when no new work exists.
MAX_NEW_JOBS_PER_CYCLE=20
MAX_REPROCESS_JOBS_PER_CYCLE=1
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_SECONDS=30
PROGRESS_REPORT_INTERVAL_SECONDS=3600

# cifra48/agent bridge
AI_API_URL=https://bridge-back.admlr.lipetsk.ru/api/v1/chat/completions
AI_API_KEY=change-me
AI_MODEL=cifra48/agent
AI_TIMEOUT_SECONDS=120
AI_REQUEST_RETRIES=3
AI_WORKER_THREADS=4
AI_REQUESTS_PER_MINUTE=6
AI_RETRY_BASE_SECONDS=10
AI_RETRY_MAX_SECONDS=120
AI_RETRY_JITTER_SECONDS=3
AI_TEMPERATURE=0
AI_MAX_TOKENS=1000
AI_IMAGE_MAX_DIMENSION=1920
AI_IMAGE_JPEG_QUALITY=88
AI_IMAGE_MAX_BYTES=5000000

# Files and runtime state
CRITERIA_FILE=criteria.txt
STATE_DB=data/parking_score.db
CACHE_DIR=data/cache
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
LOG_LEVEL=INFO
HEALTHCHECK_MAX_AGE_SECONDS=600
